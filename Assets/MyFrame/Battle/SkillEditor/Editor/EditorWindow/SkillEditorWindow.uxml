<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="TopMenu" style="height: 45px; width: auto; flex-direction: row; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31); border-bottom-width: 1px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px;">
        <ui:Button text="加载编辑器场景" display-tooltip-when-elided="true" name="LoadEditorSceneButton" enable-rich-text="true" style="width: 90px; padding-right: 6px;" />
        <ui:Button text="返回旧场景" display-tooltip-when-elided="true" name="LoadOldSceneButton" enable-rich-text="true" style="width: 90px;" />
        <ui:Button text="基本信息" display-tooltip-when-elided="true" name="SkillBasicButton" enable-rich-text="true" style="width: 90px;" />
        <uie:ObjectField label="演示角色预制体" name="PreviewCharacterPrefabObjectField" type="UnityEngine.GameObject, UnityEngine.CoreModule" allow-scene-objects="false" style="flex-shrink: 1; flex-grow: 1; flex-direction: row; justify-content: flex-start; align-items: center; -unity-text-align: upper-left; white-space: normal; font-size: 15px;" />
        <uie:ObjectField label="场景内物体" name="PreviewCharacterObjectField" type="UnityEngine.GameObject, UnityEngine.CoreModule" allow-scene-objects="true" style="flex-shrink: 1; flex-grow: 1; flex-direction: row; justify-content: flex-start; align-items: center; -unity-text-align: upper-left; white-space: normal; font-size: 15px;" />
        <uie:ObjectField label="技能配置文件" name="SkillConfigObjectField" allow-scene-objects="false" style="flex-shrink: 1; flex-grow: 1; flex-direction: row; justify-content: flex-start; align-items: center; margin-left: 0; font-size: 15px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Content" style="height: 147px; width: auto; flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="ConfigBinder" style="flex-grow: 0; flex-shrink: 0; width: 200px; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31); border-top-width: 0.5px; border-right-width: 0.5px;">
            <uie:ObjectField name="CharacterConfigField" style="margin-top: 8px;" />
            <ui:DropdownField focusable="false" name="SkillConfigChoices" />
            <ui:ListView name="SkillClipListView" virtualization-method="DynamicHeight" show-border="false" show-foldout-header="false" horizontal-scrolling="false" reorderable="true" show-add-remove-footer="false" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="Left" style="width: 200px; min-width: 150px; flex-shrink: 0; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31); border-right-width: 1px; margin-right: 0; border-top-width: 1px;">
            <ui:VisualElement name="Controller" style="height: 30px; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31); border-bottom-width: 0.5px; border-top-width: 0; flex-direction: row; flex-grow: 1; flex-shrink: 0;">
                <ui:VisualElement name="PlayController" style="flex-shrink: 0; flex-direction: row;">
                    <ui:Button text="&lt;" display-tooltip-when-elided="true" name="PreviousFrameButton" style="font-size: 12px; -unity-font-style: bold; width: auto; margin-right: 1.5px;" />
                    <ui:Button text="▶" display-tooltip-when-elided="true" name="PlayButton" style="font-size: 8px; width: auto; margin-right: 1.5px; margin-left: 1.5px;" />
                    <ui:Button text="&gt;" display-tooltip-when-elided="true" name="NextFrameButton" style="font-size: 12px; -unity-font-style: bold; width: auto; margin-right: 1.5px; margin-left: 1.5px;" />
                </ui:VisualElement>
                <ui:VisualElement name="FramerController" style="flex-shrink: 0; flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-around;">
                    <uie:IntegerField value="0" name="CurrentFrameField" style="width: 40px; height: 20px; margin-left: 3px; margin-right: 0;" />
                    <ui:Label text="/" display-tooltip-when-elided="true" style="-unity-text-align: upper-left; font-size: 18px;" />
                    <uie:IntegerField value="0" name="FrameCountField" style="width: 40px; height: 20px; margin-left: 0; margin-right: 3px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="TrackMenuScrollView" focusable="false" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement name="TrackMenuList" style="flex-grow: 1; padding-left: 4px; width: 100%; height: 100%; min-height: 1000px;" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="width: auto; min-width: auto; flex-grow: 1; flex-shrink: 1; margin-left: 0; margin-right: 0; padding-top: 0; padding-left: 10px; padding-right: 5px; border-top-width: 1px; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31);">
            <ui:IMGUIContainer name="TimerShaft" style="height: 30px; min-height: 30px; border-left-color: rgb(31, 31, 31); border-right-color: rgb(31, 31, 31); border-top-color: rgb(31, 31, 31); border-bottom-color: rgb(31, 31, 31); border-bottom-width: 0.5px; margin-right: 12px;" />
            <ui:ScrollView name="MainContentView" mode="VerticalAndHorizontal" horizontal-scroller-visibility="AlwaysVisible" vertical-scroller-visibility="AlwaysVisible" style="min-height: auto;">
                <ui:VisualElement name="ContentListView" style="min-height: 1000px;" />
            </ui:ScrollView>
            <ui:IMGUIContainer name="SelectLine" style="position: absolute; left: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
